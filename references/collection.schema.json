{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Research collection inputs, version 1",
  "description": "Local helper boundary. The host provides actual invocation identities and capture permissions; structural validation cannot establish truth or prove independence.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/registration"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/packet"
    },
    {
      "$ref": "#/$defs/finish"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "workstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "questions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "supplied_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/text"
        },
        "file": {
          "$ref": "#/$defs/text"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "dependentRequired": {
        "file": [
          "sha256"
        ]
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "topic",
        "audience",
        "scope",
        "source_mode",
        "workstreams"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "topic": {
          "$ref": "#/$defs/text"
        },
        "audience": {
          "$ref": "#/$defs/text"
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ],
          "default": "General-purpose topic research"
        },
        "source_mode": {
          "enum": [
            "public",
            "selected",
            "mixed"
          ]
        },
        "workstreams": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/workstream"
          }
        },
        "supplied_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supplied_source"
          }
        },
        "allowed_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\\.)*[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?$"
          }
        },
        "max_investigators": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 3
        },
        "execution_mode": {
          "enum": [
            "parallel",
            "sequential"
          ],
          "default": "parallel"
        },
        "input_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workstream",
        "investigator",
        "invocation"
      ],
      "properties": {
        "workstream": {
          "$ref": "#/$defs/id"
        },
        "investigator": {
          "$ref": "#/$defs/id"
        },
        "invocation": {
          "$ref": "#/$defs/text"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workstream",
        "investigator",
        "source"
      ],
      "properties": {
        "workstream": {
          "$ref": "#/$defs/id"
        },
        "investigator": {
          "$ref": "#/$defs/id"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "$ref": "synthesis.schema.json#/$defs/source"
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request_digest",
        "generation",
        "workstream",
        "attempt",
        "investigator",
        "sources",
        "facts",
        "limitations",
        "gaps"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "request_digest": {
          "$ref": "#/$defs/sha256"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "workstream": {
          "$ref": "#/$defs/id"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "investigator": {
          "$ref": "#/$defs/id"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "synthesis.schema.json#/$defs/source"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "synthesis.schema.json#/$defs/fact"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workstream",
        "investigator",
        "attempt",
        "outcome",
        "note"
      ],
      "properties": {
        "workstream": {
          "$ref": "#/$defs/id"
        },
        "investigator": {
          "$ref": "#/$defs/id"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "refused",
            "cancelled"
          ]
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}

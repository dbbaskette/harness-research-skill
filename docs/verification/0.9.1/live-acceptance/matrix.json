  "findings": [
    {
      "id": "codex-unvalidated-side-reports",
      "severity": "guidance",
      "detail": "Codex wrote its own summaries outside research/ (a project-root report.md, citation-check.md, checkpoint-starvation.md, source-refresh.md) and linked those as the deliverable instead of research/report.md. Their prose is not helper-validated; the guidance says to return research/report.md."
    },
    {
      "id": "number-rule-identifier-digits",
      "severity": "helper usability",
      "detail": "The number rule refused statements naming sqlite3_* or *_v2 identifiers because those digits were not in the quotes (three refusals across Claude Code workers). Workers reworded or added quotes; no unsupported number was accepted."
    },
    {
      "id": "from-relative-path-message",
      "severity": "helper usability",
      "detail": "A relative --from resolves against --project; the refusal 'No saved research at sqlite-wal/research.' does not say so. Codex recovered with an absolute path."
    },
    {
      "id": "start-missing-project-dir",
      "severity": "helper usability",
      "detail": "research start on a project folder that does not exist yet fails with a raw ENOENT realpath error."
    },
    {
      "id": "peek-harness-flag",
      "severity": "helper usability",
      "detail": "peek requires --worker but rejects --harness, which next accepts; two Claude Code coordinators hit it."
    },
    {
      "id": "trial-extractor-strikethrough",
      "severity": "trial tooling",
      "detail": "The trial's HTML-to-text extractor drops strikethrough, so one outdated wal.html warning read as current; the independent checker caught it on the live page and narrowed the fact."
    },
    {
      "id": "extension-scope-text",
      "severity": "report",
      "detail": "A reused run extended with a new topic keeps the origin's scope paragraph; the topic line is updated."
    },
    {
      "id": "report-length",
      "severity": "report",
      "detail": "The narrow Claude Code report is about 19.6k words for 10 questions (Codex about 6.8k for 6), echoing 0.9.0's size concern."
    }
  ],
  "limitations": [
    "The Claude Code coordinator for the initial run and task dispatch was the release-verification session, which had read the implementation; follow-up routing was by fresh subagents given only the request and skill paths.",
    "Approvals were recorded under the synthetic name 'Trial Reviewer'; they are not the owner's approval of the reports.",
    "Refresh ran the same day, so no quoted passage had changed; the changed-passage path is covered by native and installed checks, not live.",
    "Runtime and guidance were explicitly supplied from the candidate; a public tag refresh was exercised only against a disposable repository.",
    "No human sample scoring; model and mechanical checks only."
  ]
}

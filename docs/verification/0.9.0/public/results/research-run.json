      ],
      "assessment": {
        "by": "/root/skill_example_public/checker",
        "at": "2026-10-16T04:17:11.172Z"
      },
      "provisionalCoverage": "answered",
      "verdict": null,
      "headline": {
        "sentence": "SQLite runs its database engine inside the application process.",
        "facts": [
          "fact-67565f7bc4e64b29a3cf4884eb160102"
        ]
      },
      "answer": [
        {
          "sentence": "SQLite has no intermediary server process.",
          "facts": [
            "fact-469ff01539bb48c7bb52ea39823b2f9c"
          ],
          "paragraph": 1
        }
      ],
      "writtenBy": "/root/skill_example_public"
    },
    {
      "id": "sqlite-writes",
      "question": "What write concurrency does SQLite permit, and how does WAL affect readers?",
      "section": "sqlite",
      "subject": "sqlite",
      "kind": "open",
      "round": 1,
      "coverage": "answered",
      "gaps": [],
      "researchWorkers": [
        "/root/skill_example_public"
      ],
      "assessment": {
        "by": "/root/skill_example_public/checker",
        "at": "2026-10-16T04:17:11.172Z"
      },
      "provisionalCoverage": "answered",
      "verdict": null,
      "headline": {
        "sentence": "SQLite allows a single writer per database, including when WAL permits concurrent reading and writing.",
        "facts": [
          "fact-05c3180a1cab418d859780aa17d39532",
          "fact-56144cd0878b41b7ae203d9ffd23d635"
        ]
      },
      "answer": [
        {
          "sentence": "WAL mode allows readers to operate concurrently with the writer, while the single-writer constraint remains.",
          "facts": [
            "fact-05c3180a1cab418d859780aa17d39532",
            "fact-56144cd0878b41b7ae203d9ffd23d635"
          ],
          "paragraph": 1
        },
        {
          "sentence": "All processes accessing a WAL database must be on the same host; WAL does not work over a network filesystem.",
          "facts": [
            "fact-b38d5613137c4af8a1e43c21f142ca75"
          ],
          "paragraph": 2
        }
      ],
      "writtenBy": "/root/skill_example_public"
    }
  ],

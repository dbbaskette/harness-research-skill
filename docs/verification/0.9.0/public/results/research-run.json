    {
      "id": "pg-writes",
      "question": "How does PostgreSQL coordinate concurrent reads and writes, including writes to the same row?",
      "section": "postgresql",
      "subject": "postgresql",
      "kind": "open",
      "round": 1,
      "coverage": "answered",
      "gaps": [],
      "researchWorkers": [
        "/root/skill_example_public"
      ],
      "assessment": {
        "by": "/root/skill_example_public/checker",
        "at": "2026-10-16T04:16:47.002Z"
      },
      "provisionalCoverage": "answered",
      "verdict": null,
      "headline": {
        "sentence": "PostgreSQL MVCC read/write locks do not conflict, while row locks coordinate competing writers.",
        "facts": [
          "fact-0ee80ddd8ee74f8b954108ed9fd3cae2",
          "fact-80cc052b00ec44a7b04f914b98b0eeb3"
        ]
      },
      "answer": [
        {
          "sentence": "Under MVCC, locks acquired for querying data do not conflict with write locks.",
          "facts": [
            "fact-0ee80ddd8ee74f8b954108ed9fd3cae2"
          ],
          "paragraph": 1
        },
        {
          "sentence": "Row-level locks can block competing writers and lockers on the same row without blocking ordinary data queries.",
          "facts": [
            "fact-80cc052b00ec44a7b04f914b98b0eeb3"
          ],
          "paragraph": 1
        }
      ],
      "writtenBy": "/root/skill_example_public"
    },
    {
      "id": "sqlite-deployment",
      "question": "What deployment architecture does SQLite use?",
      "section": "sqlite",
      "subject": "sqlite",
      "kind": "open",
      "round": 1,
      "coverage": "answered",
      "gaps": [],
      "researchWorkers": [
